{
  "expo": {
    "name": "mobile",
    "slug": "peach-and-blue-backend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nivenxa.peachandblue"
    },
    "android": {
      "package": "in.peachandblue.app",
       "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-splash-screen"
    ],
    "extra": {
      "eas": {
        "projectId": "3c1acc82-402a-472b-9773-851c4b9d62bb"
      }
    },
    "owner": "peachnblue"
  }
}
